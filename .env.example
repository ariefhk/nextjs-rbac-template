# Copy to .env.development or .env.production and set values.
# Next.js loads .env.<NODE_ENV> automatically (e.g. next dev → .env.development).

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CSRF_SECRET=
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
SESSION_MAX_AGE=604800
MAX_SESSIONS_PER_USER=5
LOG_LEVEL=info
SENTRY_DSN=
